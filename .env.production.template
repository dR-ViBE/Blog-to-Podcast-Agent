# .env.production.template
#
# Template for the production .env file on the EC2 server.
#
# SAFE TO COMMIT — contains NO real API keys, only placeholder values.
#
# USAGE:
#   Copy this file to your EC2 at /home/ec2-user/podcast-agent/.env
#   Fill in all placeholder values with your real keys.
#   Never commit the real .env file — it is in .gitignore.
#
# HOW IT'S USED:
#   docker-compose.prod.yml loads this via `env_file: .env`
#   The AWS_ACCOUNT_ID + AWS_REGION + IMAGE_TAG vars are used to
#   construct the ECR image URIs in the image: fields.

# ─── AWS — Required for ECR image pull ───────────────────────────────────────
# These tell docker-compose.prod.yml where to pull images from.
AWS_ACCOUNT_ID=YOUR_12_DIGIT_AWS_ACCOUNT_ID
AWS_REGION=us-east-2
IMAGE_TAG=latest

# ─── LLM — Groq (fast inference) ─────────────────────────────────────────────
# Get from: https://console.groq.com → API Keys
GROQ_API_KEY=gsk_REPLACE_WITH_REAL_KEY

# ─── Text-to-Speech — ElevenLabs ─────────────────────────────────────────────
# API key: https://elevenlabs.io → Profile → API Key
# Voice ID: https://elevenlabs.io → Voices → your voice → copy the ID from URL
ELEVENLABS_API_KEY=sk_REPLACE_WITH_REAL_KEY
ELEVENLABS_VOICE_ID=REPLACE_WITH_VOICE_ID

# ─── Web Search — Tavily ─────────────────────────────────────────────────────
# Get from: https://app.tavily.com → API Keys
TAVILY_API_KEY=tvly-REPLACE_WITH_REAL_KEY

# ─── Tracing — LangSmith ─────────────────────────────────────────────────────
# Get from: https://smith.langchain.com → Settings → API Keys
LANGCHAIN_API_KEY=lsv2_pt_REPLACE_WITH_REAL_KEY
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_PROJECT=podcast-agent-production

# ─── App Metadata ─────────────────────────────────────────────────────────────
APP_NAME=blog-to-podcast-agent
APP_VERSION=1.0.0
ENVIRONMENT=production

# ─── LLM Model Selection ──────────────────────────────────────────────────────
# Change this to switch models without touching code.
LLM_MODEL=openai/gpt-oss-20b

# ─── Feature Flags ────────────────────────────────────────────────────────────
ENABLE_METRICS=true
USE_MLFLOW_PROMPT_REGISTRY=false

# ─── Persistence Paths ────────────────────────────────────────────────────────
# These paths are relative to /app inside the container (mapped via Docker volumes).
PROMETHEUS_MULTIPROC_DIR=outputs/prometheus_data
CHECKPOINT_DB_PATH=outputs/checkpoints/graph_state.db

# ─── Ollama (DO NOT CHANGE) ───────────────────────────────────────────────────
# Must point to the Docker service name, not localhost.
# docker-compose.prod.yml overrides this in the environment: block too,
# but setting it here ensures it's correct if ever run standalone.
OLLAMA_HOST=http://ollama:11434
